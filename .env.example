# Copy this file to .env.local and fill in both values from the Supabase
# dashboard: Project Settings → API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Use the *publishable* key (sb_publishable_...). Supabase is retiring the old
# "anon" key by the end of 2026. Never put the secret key here: anything in a
# VITE_ variable ships to every visitor's browser.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
